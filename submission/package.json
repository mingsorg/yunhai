{
  "name": "yunhai-agent-tool-standard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "build:check": "wrangler deploy --dry-run --outdir tmp/worker-build",
    "native:dev": "wrangler dev --config wrangler.native.jsonc --local --ip 127.0.0.1 --port 8788",
    "native:verify": "node scripts/verify-native.mjs",
    "native:build": "wrangler deploy --config wrangler.native.jsonc --env cloudflare --dry-run --outdir tmp/native-worker-build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.27.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "wrangler": "4.148.0"
  }
}
